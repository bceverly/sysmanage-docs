#!/usr/bin/env bash
# Pre-push hook — runs `make lint` in the repo root and blocks the push
# if linting fails.  Designed to be installed via `core.hooksPath` (run
# `make install-hooks` once per clone), matching the sysmanage,
# sysmanage-agent, and sysmanage-professional-plus repos.
#
# For sysmanage-docs, `make lint` covers file-length, pylint, security
# (bandit), eslint, AND the i18n gates (i18n-validate key existence +
# translate-check for untranslated strings) — so this one hook enforces
# every local gate CI would.
#
# Behaviour:
#   * No Makefile, or no `lint:` target  → silent pass (so this hook
#     can be safely set globally without breaking other repos).
#   * `make lint` exit 0                 → push proceeds.
#   * `make lint` non-zero               → push blocked; error message
#     points at the failing tool and reminds about --no-verify for
#     genuine emergencies.
#
# Pre-push is the right moment for this — pre-commit runs on every
# `git commit` and would slow down the WIP-commit-often workflow,
# whereas pre-push runs once per push to remote.  CI-style coverage
# without the per-commit tax.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${REPO_ROOT}" ]; then
    # Not in a git working tree (shouldn't happen for pre-push but
    # guard anyway).  Let git handle it.
    exit 0
fi

cd "${REPO_ROOT}"

# --- Tag safety ---------------------------------------------------------------
# `git tag` stamps whatever HEAD is at that instant.  Cut the tag BEFORE the
# commit -- which the old release ritual required, because check_version_drift.py
# resolved the version from an already-existing tag -- and the tag names the
# PREVIOUS commit for ever.  CI then checks out the tag and faithfully rebuilds
# the tree without the work.  That is how v3.5.1.24 shipped with broken OpenBSD
# and Flatpak jobs whose fixes were already sitting on main, and v3.5.1.25 the
# same way for the Windows ARM64 MSI.
#
# `make release VERSION=x.y.z` cuts the tag last and cannot hit this.  This
# check is the backstop for tags cut by hand.  It fires ONLY when the tag is a
# strict ancestor of HEAD, so deliberately tagging an unrelated commit is
# unaffected.  Override for a deliberate historical tag:
#     SYSMANAGE_ALLOW_STALE_TAG=1 git push origin <tag>
stale_tag=""
if [ -z "${SYSMANAGE_ALLOW_STALE_TAG:-}" ]; then
while read -r local_ref local_sha _remote_ref _remote_sha; do
case "${local_ref}" in refs/tags/*) ;; *) continue ;; esac
case "${local_sha}" in *[!0]*) ;; *) continue ;; esac
tagged="$(git rev-parse -q --verify "${local_sha}^{commit}" 2>/dev/null || true)"
[ -n "${tagged}" ] || continue
head_sha="$(git rev-parse -q --verify HEAD 2>/dev/null || true)"
[ -n "${head_sha}" ] || continue
[ "${tagged}" != "${head_sha}" ] || continue
git merge-base --is-ancestor "${tagged}" "${head_sha}" 2>/dev/null || continue
behind="$(git rev-list --count "${tagged}..${head_sha}" 2>/dev/null || echo '?')"
tag_name="${local_ref#refs/tags/}"
echo ""
echo "============================================================"
echo " Pre-push BLOCKED: ${tag_name} is ${behind} commit(s) behind HEAD."
echo "============================================================"
echo ""
echo "   ${tag_name}  ->  $(git log --oneline -1 "${tagged}")"
echo "   HEAD         ->  $(git log --oneline -1 "${head_sha}")"
echo ""
echo " CI checks out the TAG, so it would rebuild the older tree and"
echo " nothing in the commit(s) above would ship."
echo ""
echo " Move the tag onto this commit, then push it:"
echo ""
echo "     git tag -f -a ${tag_name} -m '<message>' && git push -f origin ${tag_name}"
echo ""
echo " Or cut releases with 'make release VERSION=x.y.z', which tags last."
echo ""
echo " Tagging an older commit on purpose?"
echo "     SYSMANAGE_ALLOW_STALE_TAG=1 git push origin ${tag_name}"
echo ""
stale_tag=1
done
fi
[ -z "${stale_tag}" ] || exit 1


# Skip the check unless the repo declares a `lint:` target.  Three
# practical reasons:
#   1. If someone sets this globally (`git config --global
#      core.hooksPath ~/.git-hooks`), other repos without a lint
#      target shouldn't be punished.
#   2. Lets us add the hook to a new repo by simply landing a
#      Makefile + lint target there — no per-repo config dance.
#   3. The check is fast (a grep) so the overhead is negligible.
if [ ! -f Makefile ] || ! grep -qE '^lint:[[:space:]]*' Makefile; then
    exit 0
fi

REPO_NAME="$(basename "${REPO_ROOT}")"
echo ""
echo "============================================================"
echo " Pre-push: running 'make lint' in ${REPO_NAME}..."
echo "============================================================"

# Let the Makefile choose the shell — do NOT pass SHELL=... on the command line.
# A command-line assignment overrides the makefile's own `SHELL :=`, and this
# repo deliberately pins Git Bash (its recipes are POSIX sh, unlike the sibling
# sysmanage repos' cmd batch).  Forcing SHELL=cmd.exe here ran those POSIX
# recipes through `cmd.exe -c`, which cmd doesn't understand: it opened an
# INTERACTIVE cmd that inherited this hook's stdin — the ref list git pipes to
# pre-push — and tried to execute it ("'refs' is not recognized ...").
#
# stdin is redirected from /dev/null for the same reason: `make lint` never needs
# the ref list, and any child that reads stdin would swallow the push data or
# block waiting on a console.
run_make_lint() {
    case "$(uname -s 2>/dev/null)" in
        OpenBSD|FreeBSD|NetBSD) gmake lint </dev/null ;;
        *)                      make  lint </dev/null ;;
    esac
}

if run_make_lint; then
    echo ""
    echo "============================================================"
    echo " Pre-push: lint clean — pushing."
    echo "============================================================"
    exit 0
fi

echo ""
echo "============================================================"
echo " Pre-push: 'make lint' FAILED in ${REPO_NAME}."
echo "============================================================"
echo ""
echo " Fix the errors above, then push again.  In a genuine"
echo " emergency you can bypass this hook with:"
echo ""
echo "     git push --no-verify"
echo ""
echo " (but the next make-lint run on CI will fail the same way,"
echo " so the bypass only buys you time, not a real fix.)"
echo ""
exit 1
